# ==============================================================================
# Data: too big for GitHub (100 MB per-file limit). Code that builds/downloads
# it stays tracked; see "Sharing data" in the README for where the data lives.
# ==============================================================================
# LanceDB vector store, ingestion progress, Acts chunks (~15 GB)
/data/*
!/data/README.md

# Public Indian-legal-data-v3 dataset (re-downloadable from Hugging Face)
/finetuning_data/

# Fine-tuning train/val splits and synthetic-data intermediates
/to_finetune/data/
/finetune/data/

# law dataset/: keep the download/extract scripts, drop the raw data
/law dataset/*.jsonl
/law dataset/*.pdf

# Scratch / one-off large files in the repo root
/filtered_data.txt
/hc_file_no.txt
/test/curated_extra.jsonl

# Catch-all for large data formats anywhere
*.parquet
*.arrow
*.lance
*.pkl
*.pickle
*.joblib
*.db
*.sqlite
*.sqlite3

